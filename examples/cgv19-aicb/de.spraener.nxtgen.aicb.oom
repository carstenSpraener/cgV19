import de.spraener.nxtgen.groovy.ModelDSL

ModelDSL.make {
    mPackage {
        name 'de.spraener.nxtgen.aicb'
        mClass {
            name 'AiCodeBlockCartridge'
            stereotype 'cgV19Cartridge'
        }
    }

    mPackage {
        name 'demoapp'
        mClass {
            name 'GreetingService'
            stereotype 'PoJo'
            attribute {
                name 'name'
                type 'String'
            }
            attribute {
                name 'age'
                type 'int'
            }
            operation {
                name 'greet'
                type 'String'
            }
        }
    }
}
